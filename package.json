{
  "name": "glassbox",
  "version": "0.0.1",
  "description": "画布是代码的函数。A real-time dashboard for AI-assisted development, derived from code, git, tests and agent events.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "glassbox": "bin/glassbox.js"
  },
  "scripts": {
    "start": "node src/cli.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json",
    "test": "node --test test/*.test.ts",
    "check": "npm run typecheck && npm test",
    "web:dev": "vite --config web/vite.config.ts",
    "web:build": "vite build --config web/vite.config.ts"
  },
  "dependencies": {
    "@vscode/tree-sitter-wasm": "^0.3.1",
    "@xyflow/react": "^12.12.0",
    "elkjs": "^0.12.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "pyright": "^1.1.414",
    "typescript": "~5.9.0",
    "vite": "^7.3.7"
  }
}
